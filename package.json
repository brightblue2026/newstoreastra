{
  "name": "bbtc-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "invoice:sample": "tsx --tsconfig tsconfig.scripts.json scripts/sample-invoice.ts",
    "user:create": "tsx scripts/create-staff-user.ts",
    "storage:setup": "tsx scripts/setup-storage.ts",
    "qa:shoot": "tsx scripts/shoot.ts",
    "e2e:razorpay": "node --env-file=.env --conditions=react-server --import tsx scripts/e2e-razorpay.ts",
    "qa:perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.6.0",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.25",
    "motion": "^12.43.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.83.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
