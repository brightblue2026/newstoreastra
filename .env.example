# Bright Blue store — environment template.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Phase 0 needs only DATABASE_URL and AUTH_SECRET. Everything else is listed so
# the shape is known ahead of the phase that needs it.

# ---------- Database (Phase 0) ----------
# Neon Postgres. Use the POOLED connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/bbtc?sslmode=require"
# Direct (unpooled) connection, used by `prisma migrate`.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/bbtc?sslmode=require"

# ---------- Auth (Phase 0) ----------
# Generate with: npx auth secret
# Also signs the capability token on a customer's order link (lib/order-access.ts),
# so rotating it invalidates every link already sent. They can still be reopened
# with the order number and mobile number.
AUTH_SECRET=""
# Set to the deployed origin in production. Vercel provides this automatically.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Images (Phase 1) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Errors (Phase 0, optional locally) ----------
# Leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---------- Payments (Phase 5) ----------
# Test keys start rzp_test_. Never put the secret in a NEXT_PUBLIC_ variable.
# With these unset, checkout still works and offers cash on delivery only —
# /admin/settings says so on the page rather than failing at the last step.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From the Razorpay dashboard when registering the webhook endpoint. Point the
# webhook at POST /api/webhooks/razorpay and subscribe to payment.captured,
# payment.authorized, payment.failed and order.paid. Unset means every webhook
# is rejected with a 400 — it fails closed, so nothing can confirm an order.
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Logistics (Phase 6) ----------
# Shiprocket API user, created under Settings → API → Configure in the
# Shiprocket dashboard. Not the dashboard login — an API user is a separate
# account with its own password.
#
# With these unset, checkout still works: delivery is priced from the flat-rate
# slab table in /admin/settings, which §10 wants as the fallback anyway. The
# pickup pincode and pickup location name live in /admin/settings, not here,
# because they are operational settings rather than credentials.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Shared secret for POST /api/webhooks/shiprocket, set alongside the webhook URL
# in the dashboard and sent back as an x-api-key header. Unset means every
# tracking webhook is rejected — it fails closed.
SHIPROCKET_WEBHOOK_TOKEN=""

# ---------- Email (Phase 6) ----------
# The domain in RESEND_FROM_EMAIL has to be verified in Resend first, or every
# send is rejected. Unset RESEND_API_KEY means no email is sent and a warning is
# logged; an order is never blocked by it.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@brightblue.in"

# ---------- WhatsApp / SMS (Phase 5 templates, Phase 6 sending) ----------
MSG91_AUTH_KEY=""
# Six-character DLT-registered sender id for SMS, e.g. "BBTCIN". SMS only.
MSG91_SENDER_ID=""
# The WhatsApp Business number registered with MSG91, country code included.
# It cannot be the toll-free 1800 123 0621 — toll-free numbers cannot host
# WhatsApp Business. See docs/msg91-templates.md.
MSG91_WHATSAPP_NUMBER=""

# The four approved template names, from docs/msg91-templates.md. Meta assigns
# these at approval, so they cannot be known ahead of time — a template with no
# name set here is skipped with a log rather than sent as something else. Fill
# them in one at a time as approvals come back.
MSG91_TEMPLATE_ORDER_CONFIRMED="bbtc_order_confirmed"
MSG91_TEMPLATE_ORDER_SHIPPED="bbtc_order_shipped"
MSG91_TEMPLATE_OUT_FOR_DELIVERY="bbtc_out_for_delivery"
# Blocked on §14 Q18 (the return policy), not on approval — see the doc.
MSG91_TEMPLATE_ORDER_DELIVERED=""

# DLT content template ids for the SMS fallback. Registered separately from the
# WhatsApp templates, on the operator DLT portal against BBTC's principal
# entity id. Numeric ids, not names.
MSG91_SMS_TEMPLATE_ORDER_CONFIRMED=""
MSG91_SMS_TEMPLATE_ORDER_SHIPPED=""
MSG91_SMS_TEMPLATE_OUT_FOR_DELIVERY=""
MSG91_SMS_TEMPLATE_ORDER_DELIVERED=""

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
