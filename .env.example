# Bright Blue store — environment template.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Phase 0 needs only DATABASE_URL and AUTH_SECRET. Everything else is listed so
# the shape is known ahead of the phase that needs it.

# ---------- Database (Phase 0) ----------
# Neon Postgres. Use the POOLED connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/bbtc?sslmode=require"
# Direct (unpooled) connection, used by `prisma migrate`.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/bbtc?sslmode=require"

# ---------- Auth (Phase 0) ----------
# Generate with: npx auth secret
AUTH_SECRET=""
# Set to the deployed origin in production. Vercel provides this automatically.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Images (Phase 1) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Errors (Phase 0, optional locally) ----------
# Leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---------- Payments (Phase 5) ----------
# Test keys start rzp_test_. Never put the secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From the Razorpay dashboard when registering the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Logistics (Phase 6) ----------
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_WEBHOOK_TOKEN=""

# ---------- Email (Phase 6) ----------
RESEND_API_KEY=""
# Resend can only send as an address on a domain it has verified via DNS
# (SPF/DKIM) — it cannot send as a gmail.com address. The store's real contact
# mailbox (store-brightbluefmcg@gmail.com, used for CONTACT.email / the
# "Price on request" enquiry link) cannot be this value. Set this to a mailbox
# on a domain you can add DNS records to (e.g. orders@brightbluefmcg.com) once
# that domain is verified in Resend. See DECISIONS.md "bbtcglobal.com /
# brightbluefmcg.com domain roles".
RESEND_FROM_EMAIL="orders@brightbluefmcg.com"

# ---------- WhatsApp / SMS (Phase 5) ----------
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_WHATSAPP_NUMBER=""

# ---------- Site ----------
# Production: https://www.brightbluefmcg.com — that is where the store itself
# is hosted. bbtcglobal.com is a separate static corporate site, not this app.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
