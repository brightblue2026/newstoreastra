# Bright Blue store — environment template.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Phase 0 needs only DATABASE_URL and AUTH_SECRET. Everything else is listed so
# the shape is known ahead of the phase that needs it.

# ---------- Database (Phase 0) ----------
# Supabase Postgres. Project settings > Database > Connection string.
#
# The app uses the POOLED connection (port 6543, "Transaction" mode).
#
# Paste the strings exactly as the dashboard gives them — no `sslmode`. TLS is
# switched on and verified against Supabase's own root certificate in code
# (src/lib/pg-config.ts); `sslmode=require` in the URL fails with
# SELF_SIGNED_CERT_IN_CHAIN and is stripped anyway.
#
# A password containing @ : / ? # or % must be percent-encoded (@ is %40),
# or the URL splits at the wrong place.
#
# The project should be in ap-south-1 (Mumbai). Every order is several round
# trips, and the Worker is placed near the database (wrangler.jsonc).
#
# These two are for local development, the seeds and the scripts. The deployed
# Worker does not read them: it connects through the Hyperdrive binding.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# `prisma migrate` uses the DIRECT connection (port 5432). The pooler cannot
# carry the session state migrations need — see prisma.config.ts.
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------- Auth (Phase 0) ----------
# Generate with: npx auth secret
# Also signs the capability token on a customer's order link (lib/order-access.ts),
# so rotating it invalidates every link already sent. They can still be reopened
# with the order number and mobile number.
AUTH_SECRET=""
# Set to the deployed origin in production (`vars` in wrangler.jsonc).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Optional: staff "Sign in with GitHub". Leave blank to hide the button.
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# Callback URL: <AUTH_URL>/api/auth/callback/github
# A GitHub account gets in only if one of its *verified* emails matches an
# active staff User. It never creates an account or grants a role.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------- Images (Phase 1) ----------
# Supabase — Postgres and Storage. Project settings > API.
# SUPABASE_URL is https://<ref>.supabase.co
# The service-role key is a server secret: it bypasses row-level security and
# must never be exposed to the browser or committed.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Errors (Phase 0, optional locally) ----------
# Leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---------- Payments (Phase 5) ----------
# Test keys start rzp_test_. Never put the secret in a NEXT_PUBLIC_ variable.
# With these unset, checkout still works and offers cash on delivery only —
# /admin/settings says so on the page rather than failing at the last step.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From the Razorpay dashboard when registering the webhook endpoint. Point the
# webhook at POST /api/webhooks/razorpay and subscribe to payment.captured,
# payment.failed and order.paid. Leave payment capture on "automatic" in the
# dashboard: an authorised-but-uncaptured payment never confirms an order.
# Unset means every webhook is rejected with a 400 — it fails closed, so
# nothing can confirm an order.
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Logistics (Phase 6) ----------
# Shiprocket API user, created under Settings → API → Configure in the
# Shiprocket dashboard. Not the dashboard login — an API user is a separate
# account with its own password.
#
# With these unset, checkout still works: delivery is priced from the flat-rate
# slab table in /admin/settings, which §10 wants as the fallback anyway.
# Server-only: never prefix these with NEXT_PUBLIC_. The older SHIPROCKET_EMAIL /
# SHIPROCKET_PASSWORD names are still read if these are unset.
SHIPROCKET_API_EMAIL=""
SHIPROCKET_API_PASSWORD=""
# Fallback pickup point, used only until one is saved in /admin/settings → Shiprocket
# (what is saved there wins). The location is the pickup name exactly as it appears in
# the Shiprocket dashboard; the pincode is its six-digit pincode.
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_PICKUP_PINCODE=""
# Shared secret for the tracking webhook. In the Shiprocket dashboard set the URL to
# <site>/api/webhooks/courier-tracking (it refuses URLs containing "shiprocket"),
# with this value as the token. Set alongside the webhook URL
# in the dashboard and sent back as an x-api-key header. Unset means every
# tracking webhook is rejected — it fails closed.
SHIPROCKET_WEBHOOK_TOKEN=""

# ---------- Email (Phase 6) ----------
# The domain in RESEND_FROM_EMAIL has to be verified in Resend first, or every
# send is rejected. Unset RESEND_API_KEY means no email is sent and a warning is
# logged; an order is never blocked by it.
RESEND_API_KEY=""
# Resend can only send as an address on a domain it has verified via DNS
# (SPF/DKIM) — it cannot send as a gmail.com address. The store's real contact
# mailbox (store-brightbluefmcg@gmail.com, used for CONTACT.email / the
# "Price on request" enquiry link) cannot be this value. Set this to a mailbox
# on a domain you can add DNS records to (e.g. orders@brightbluefmcg.com) once
# that domain is verified in Resend. See DECISIONS.md "bbtcglobal.com /
# brightbluefmcg.com domain roles".
RESEND_FROM_EMAIL="orders@brightbluefmcg.com"

# ---------- WhatsApp / SMS (Phase 5 templates, Phase 6 sending) ----------
MSG91_AUTH_KEY=""
# Six-character DLT-registered sender id for SMS, e.g. "BBTCIN". SMS only.
MSG91_SENDER_ID=""
# The WhatsApp Business number registered with MSG91, country code included.
# It cannot be the toll-free 1800 123 0621 — toll-free numbers cannot host
# WhatsApp Business. See docs/msg91-templates.md.
MSG91_WHATSAPP_NUMBER=""

# The four approved template names, from docs/msg91-templates.md. Meta assigns
# these at approval, so they cannot be known ahead of time — a template with no
# name set here is skipped with a log rather than sent as something else. Fill
# them in one at a time as approvals come back.
MSG91_TEMPLATE_ORDER_CONFIRMED="bbtc_order_confirmed"
MSG91_TEMPLATE_ORDER_SHIPPED="bbtc_order_shipped"
MSG91_TEMPLATE_OUT_FOR_DELIVERY="bbtc_out_for_delivery"
# Blocked on §14 Q18 (the return policy), not on approval — see the doc.
MSG91_TEMPLATE_ORDER_DELIVERED=""

# DLT content template ids for the SMS fallback. Registered separately from the
# WhatsApp templates, on the operator DLT portal against BBTC's principal
# entity id. Numeric ids, not names.
MSG91_SMS_TEMPLATE_ORDER_CONFIRMED=""
MSG91_SMS_TEMPLATE_ORDER_SHIPPED=""
MSG91_SMS_TEMPLATE_OUT_FOR_DELIVERY=""
MSG91_SMS_TEMPLATE_ORDER_DELIVERED=""

# ---------- Rate limiting ----------
# Upstash Redis, REST-based — free tier is enough to start. Create a database
# at upstash.com/redis, then Details → REST API for these two values.
# With these unset, staff login, checkout and both webhooks are NOT rate
# limited (a warning is logged on every check) rather than the app failing to
# start — see lib/rate-limit.ts. Set these before relying on the limits for
# anything real.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Scheduled jobs ----------
# Bearer token the Worker's cron handler sends on every scheduled run (see
# worker.ts and `triggers` in wrangler.jsonc) — generate with
# `openssl rand -hex 32`. Anyone who has this
# value can trigger the stale-order sweep on demand; that is a low-stakes
# operation (it only cancels orders already past their payment window), but
# the endpoint still checks it so it isn't a public "cancel my order" button.
CRON_SECRET=""

# ---------- Site ----------
# Production: https://www.brightbluefmcg.com — that is where the store itself
# is hosted. bbtcglobal.com is a separate static corporate site, not this app.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Search Console HTML verification token (public, not a credential).
GOOGLE_SITE_VERIFICATION=""
