# Build-time configuration for the production deployment. Tracked in git.
#
# PUBLIC VALUES ONLY. Everything here ends up in the browser bundle or in page
# HTML anyway. Secrets are set on the Worker with `wrangler secret put` and
# must never be added to this file.
#
# These have to exist at build time, not just at runtime: Next inlines
# `NEXT_PUBLIC_*` into the bundle, and canonical URLs, the sitemap and JSON-LD
# are rendered from NEXT_PUBLIC_SITE_URL while pages are prerendered. Keep them
# in step with `vars` in wrangler.jsonc.
NEXT_PUBLIC_SITE_URL="https://brightbluefmcg.com"
AUTH_URL="https://brightbluefmcg.com"
AUTH_TRUST_HOST="true"
SUPABASE_URL="https://mjbebzlknjowvwhmzzzd.supabase.co"
# Razorpay *test* key id — publishable by design.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_TkdJvcsV1WCSON"
