// Cloudflare Workers deployment, built by @opennextjs/cloudflare.
//
// Nothing secret lives here. Secrets (AUTH_SECRET, SUPABASE_SERVICE_ROLE_KEY,
// RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, CRON_SECRET) are set with
// `wrangler secret put`; local previews read them from the gitignored .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard, or its Git
  // builds fail with "This Worker does not exist on your account".
  "name": "store",
  // The custom entry wraps the generated worker to add the cron handler.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Run next to the database rather than next to the visitor: an order is
  // several Postgres round trips, and Supabase is in Mumbai.
  "placement": { "mode": "smart" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "store" }],
  "images": { "binding": "IMAGES" },
  // ISR cache, tag cache and revalidation queue: see open-next.config.ts.
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "72e56cef7bdb4339afe4cc8a7e2cfb84" }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "bbtc-store-tag-cache",
      "database_id": "9dc4a826-27c4-4641-8323-233744530472"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // Postgres. Hyperdrive (config `bbtc-store-db`) pools connections to Supabase; `localConnectionString`
  // is what `wrangler dev` uses instead, the Docker database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "aa1b518b347d403e8adbff21e02e0144",
      "localConnectionString": "postgresql://bbtc:bbtc@localhost:5432/bbtc_store"
    }
  ],
  // Public configuration only. `NEXT_PUBLIC_*` values are also needed in the
  // build environment, because Next inlines them into the browser bundle.
  "vars": {
    "AUTH_URL": "https://brightbluefmcg.com",
    "AUTH_TRUST_HOST": "true",
    "NEXT_PUBLIC_SITE_URL": "https://brightbluefmcg.com",
    "SUPABASE_URL": "https://mjbebzlknjowvwhmzzzd.supabase.co",
    // The Razorpay live key id. Public by design; the secret is not here.
    "NEXT_PUBLIC_RAZORPAY_KEY_ID": "rzp_live_TmwzIL8nsNP56q",
    "RESEND_FROM_EMAIL": "orders@brightbluefmcg.com"
  },
  // Cancels unpaid orders past their payment window; see worker.ts.
  "triggers": { "crons": ["*/15 * * * *"] }
}
