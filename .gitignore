# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never enter the repo, but the template must
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sentry
.sentryclirc

# prisma — generated client, never committed
/src/generated/prisma

# client-supplied compliance documents and product photos — contain personal
# ID/address data (trade licence, FSSAI/GST certs) and are dropped directly in
# the repo root. Local reference only, never git history. (docs/*.pdf is a
# separate, intentionally-tracked folder and is unaffected by this.)
/*.pdf
/WhatsApp Image*.jpeg
# Same material, now arriving in a per-brand folder rather than the root
# (labels, licence scans, the "all legal details" archive).
/Brand details/


# Generated sample invoices for review — not source.
/tmp/
